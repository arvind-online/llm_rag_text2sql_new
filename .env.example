# LLM Provider: "groq", "ollama", or "bedrock"
LLM_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=ap-south-1
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=

# Database Type: "postgres" or "clickhouse"
DB_TYPE=postgres

# PostgreSQL Database Configuration
PGHOST=db.symkcqsvcrtgqmqcsfuq.supabase.co
PGUSER=postgres
PGPASSWORD=Supabase@32145
PGDATABASE=postgres
PGPORT=5432

# ClickHouse Database Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Table Filtering - comma-separated list of tables to include in schema
# Leave empty to include all tables
# Example: TABLE_FILTER_LIST=vehicles,odometer_readings
TABLE_FILTER_LIST=vehicles,odometer_readings

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
